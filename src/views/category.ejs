<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= category.name %>
        </h2>
        <h3>Service Projects</h3>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong>
                            <%= project.title %>
                        </strong>
                    </a>
                    <p>
                        <%= project.description %>
                            <% }) %>
                    </p>
                </li>
        </ul>
        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-category/<%= category.category_id %>" class="link">Edit category</a>
                <% } %>
        </p>

    </main>
    <%- include('partials/footer') %>