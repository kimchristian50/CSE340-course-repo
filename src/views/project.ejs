<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= project.title %>
        </h2>
        <p>
            <!-- <a href="/edit-project/<%= project.project_id %>" class="link">Edit</a> -->
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-project/<%= project.project_id %>" class="link">Edit Project</a>
                <% } %>
        </p>
        <p>
            <%= project.description %>
        </p>
        <p>
            <%= project.date.toLocaleDateString('en-US', { month: 'long' , day: 'numeric' , year: 'numeric' }) %> - <%=
                    project.location %>
        </p>
        <h3>Categories:</h3>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>" class="tag">
                        <%= category.name %>
                    </a>

                </li>
                <% }); %>

        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <a href="/assign-categories/<%= project.project_id %>" class="link">Edit Categories</a>
            <% } %>
                <p></p>
                <p>Sponsored by:
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>

    </main>
    <%- include('partials/footer') %>